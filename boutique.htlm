          <p>
            Produits issus de nos activités aquatiques,
            selon les disponibilités.
          </p>

        </div>


        <div class="product-grid">


          <article class="product-card">

            <div class="product-image">
              🐟
            </div>

            <div class="product-content">

              <span class="product-category">
                AQUACULTURE
              </span>

              <h3>
                Poissons d'élevage
              </h3>

              <p>
                Poissons issus de la production aquacole.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Poissons d'élevage"
              >
                Commander
              </button>

            </div>

          </article>


          <article class="product-card">

            <div class="product-image">
              🎣
            </div>

            <div class="product-content">

              <span class="product-category">
                PÊCHE
              </span>

              <h3>
                Produits de pêche
              </h3>

              <p>
                Produits aquatiques disponibles selon les arrivages.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Produits de pêche"
              >
                Commander
              </button>

            </div>

          </article>


        </div>

      </div>

    </section>


    <!-- PRODUITS VEGETAUX -->
    <section
      id="vegetaux"
      class="section section-light"
    >

      <div class="container">

        <div class="section-heading">

          <span class="section-tag">
            PRODUCTION VÉGÉTALE
          </span>

          <h2>
            Produits agricoles
          </h2>

          <p>
            Productions végétales disponibles selon les saisons
