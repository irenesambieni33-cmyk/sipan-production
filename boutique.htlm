<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Boutique | AGROTRIA</title>

  <meta
    name="description"
    content="Découvrez les produits agricoles et solutions proposés par AGROTRIA."
  >

  <link rel="manifest" href="manifest.json">
  <link rel="icon" href="favicon-32.png" type="image/png">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">

  <link rel="stylesheet" href="styles.css">
</head>

<body>

  <!-- HEADER -->
  <header class="site-header">

    <div class="container nav-container">

      <a href="index.html" class="logo">
        <img
          src="agrotria-logo.png"
          alt="Logo AGROTRIA"
          class="logo-image"
        >
        <span>AGRO<b>TRIA</b></span>
      </a>
 
      <button
        class="menu-toggle"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
      >
        ☰
      </button>

      <nav class="main-nav">

        <a href="index.html">
          Accueil
        </a>

        <a href="a-propos.html">
          À propos
        </a>

        <a href="equipe.html">
          Notre équipe
        </a>

        <a href="activites.html">
          Nos activités
        </a>

        <a href="boutique.html" class="active">
          Boutique
        </a>

        <a href="blog.html">
          Conseils / Blog
        </a>

        <a href="contact.html">
          Contact
        </a>

      </nav>

    </div>

  </header>


  <!-- CONTENU -->
  <main>

    <!-- HERO -->
    <section class="page-hero">

      <div class="container">

        <span class="section-tag">
          BOUTIQUE AGROTRIA
        </span>

        <h1>
          Nos produits & solutions agricoles
        </h1>

        <p>
          Découvrez notre sélection de produits agricoles,
          d'élevage, aquacoles et de solutions pour les producteurs.
        </p>

      </div>

    </section>


    <!-- CATEGORIES -->
    <section class="section">

      <div class="container">

        <div class="section-heading center">

          <span class="section-tag">
            NOS CATÉGORIES
          </span>

          <h2>
            Explorez notre boutique
          </h2>

          <p>
            Une boutique pensée pour rapprocher les produits
            agricoles des clients.
          </p>

        </div>


        <div class="category-grid">

          <a href="#animaux" class="category-card">
            <span>🐔</span>
            <h3>Produits animaux</h3>
            <p>Produits issus de l'élevage.</p>
          </a>

          <a href="#aquaculture" class="category-card">
            <span>🐟</span>
            <h3>Produits aquacoles</h3>
            <p>Produits issus de la pêche et de l'aquaculture.</p>
          </a>

          <a href="#vegetaux" class="category-card">
            <span>🌾</span>
            <h3>Produits végétaux</h3>
            <p>Productions agricoles et végétales.</p>
          </a>

          <a href="#equipements" class="category-card">
            <span>🧰</span>
            <h3>Équipements</h3>
            <p>Solutions et équipements agricoles.</p>
          </a>

        </div>

      </div>

    </section>


    <!-- PRODUITS ANIMAUX -->
    <section
      id="animaux"
      class="section section-light"
    >

      <div class="container">

        <div class="section-heading">

          <span class="section-tag">
            PRODUITS ANIMAUX
          </span>

          <h2>
            Élevage & produits d'origine animale
          </h2>

        </div>


        <div class="product-grid">


          <article class="product-card">

            <div class="product-image">
              🐔
            </div>

            <div class="product-content">

              <span class="product-category">
                VOLAILLE
              </span>

              <h3>
                Poulets de chair
              </h3>

              <p>
                Poulets destinés à la consommation.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Poulets de chair"
              >
                Commander
              </button>

            </div>

          </article>


          <article class="product-card">

            <div class="product-image">
              🥚
            </div>

            <div class="product-content">

              <span class="product-category">
                VOLAILLE
              </span>

              <h3>
                Œufs de consommation
              </h3>

              <p>
                Œufs issus de poules pondeuses.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Œufs de consommation"
              >
                Commander
              </button>

            </div>

          </article>


          <article class="product-card">

            <div class="product-image">
              🐇
            </div>

            <div class="product-content">

              <span class="product-category">
                CUNICULTURE
              </span>

              <h3>
                Lapins
              </h3>

              <p>
                Lapins destinés à la consommation.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Lapins"
              >
                Commander
              </button>

            </div>

          </article>


          <article class="product-card">

            <div class="product-image">
              🐖
            </div>

            <div class="product-content">

              <span class="product-category">
                ÉLEVAGE
              </span>

              <h3>
                Porcs
              </h3>

              <p>
                Animaux d'élevage destinés à la consommation.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Porcs"
              >
                Commander
              </button>

            </div>

          </article>


        </div>

      </div>

    </section>


    <!-- AQUACULTURE -->
    <section
      id="aquaculture"
      class="section"
    >

      <div class="container">

        <div class="section-heading">

          <span class="section-tag">
            PÊCHE & AQUACULTURE
          </span>

          <h2>
            Produits aquatiques
