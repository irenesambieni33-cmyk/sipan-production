              >
                Commander
              </button>

            </div>

          </article>


          <article class="product-card">

            <div class="product-image">
              🥬
            </div>

            <div class="product-content">

              <span class="product-category">
                PRODUITS VÉGÉTAUX
              </span>

              <h3>
                Produits maraîchers
              </h3>

              <p>
                Produits frais selon les disponibilités.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Produits maraîchers"
              >
                Commander
              </button>

            </div>

          </article>


        </div>

      </div>

    </section>


    <!-- EQUIPEMENTS -->
    <section
      id="equipements"
      class="section"
    >

      <div class="container">

        <div class="section-heading">

          <span class="section-tag">
            DISTRIBUTION & SERVICES
          </span>

          <h2>
            Équipements & solutions
          </h2>

          <p>
            Une sélection d'équipements et de solutions destinés
            à accompagner les producteurs.
          </p>

        </div>


        <div class="product-grid">


          <article class="product-card">

            <div class="product-image">
              🧰
            </div>

            <div class="product-content">

              <span class="product-category">
                ÉQUIPEMENT
              </span>

              <h3>
                Matériel d'élevage
              </h3>

              <p>
                Équipements destinés aux activités d'élevage.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Matériel d'élevage"
              >
                Commander
              </button>

            </div>

          </article>


          <article class="product-card">

            <div class="product-image">
              🚜
            </div>

            <div class="product-content">

              <span class="product-category">
                AGRICULTURE
              </span>

              <h3>
                Solutions agricoles
              </h3>

              <p>
                Produits et solutions pour accompagner les producteurs.
              </p>

              <strong class="product-price">
                Prix sur demande
              </strong>

              <button
                class="btn btn-primary whatsapp-order"
                data-product="Solutions agricoles"
              >
                Commander
              </button>

            </div>

          </article>


        </div>

      </div>

    </section>


    <!-- COMMENT COMMANDER -->
    <section class="section section-light">

      <div class="container">

        <div class="section-heading center">

          <span class="section-tag">
            COMMENT COMMANDER ?
          </span>

          <h2>
            Une commande simple et rapide
          </h2>

        </div>


        <div class="steps-grid">


          <div class="step-card">

            <span>
              01
            </span>

            <h3>
              Choisissez
            </h3>

            <p>
              Sélectionnez le produit qui vous intéresse.
            </p>

          </div>


          <div class="step-card">

            <span>
              02
            </span>

            <h3>
              Contactez-nous
            </h3>

            <p>
              Appuyez sur le bouton « Commander ».
            </p>

          </div>


          <div class="step-card">

            <span>
              03
            </span>

            <h3>
              Confirmez
            </h3>

            <p>
              Nous échangeons avec vous pour confirmer
              la disponibilité et les modalités.
            </p>

          </div>


        </div>

      </div>

    </section>


    <!-- CTA -->
    <section class="cta-section">

      <div class="container">

        <h2>
          Vous recherchez un produit particulier ?
        </h2>

        <p>
          Contactez directement AGROTRIA pour connaître
          les disponibilités.
        </p>

        <div class="cta-buttons">

          <a
            href="https://wa.me/2290147544702"
            class="btn btn-primary"
            target="_blank"
            rel="noopener"
          >
            WhatsApp
          </a>

          <a
            href="contact.html"
            class="btn btn-outline"
          >
            Contact
          </a>

        </div>

      </div>

    </section>

  </main>


